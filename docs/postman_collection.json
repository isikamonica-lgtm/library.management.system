{
  "info": {
    "name": "Library Management System - Week 2 API",
    "description": "Week 2 API collection. Run the login requests to save tokens automatically. Set librarianPassword as a collection variable before using Login Librarian.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "patronToken",
      "value": ""
    },
    {
      "key": "librarianToken",
      "value": ""
    },
    {
      "key": "librarianPassword",
      "value": ""
    },
    {
      "key": "bookId",
      "value": "1"
    },
    {
      "key": "genreId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Test Patron\",\n  \"email\": \"newpatron@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login Patron",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron2@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().access_token) {",
                  "  pm.collectionVariables.set('patronToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Librarian",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.com\",\n  \"password\": \"{{librarianPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().access_token) {",
                  "  pm.collectionVariables.set('librarianToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books"
            }
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?search=Programming"
            }
          }
        },
        {
          "name": "Filter and Paginate Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genreId={{genreId}}&page=1&limit=10"
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}"
            }
          }
        },
        {
          "name": "Create Book - Librarian",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/books"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book\",\n  \"author\": \"Test Author\",\n  \"isbn\": \"9781234567890\",\n  \"totalCopies\": 5,\n  \"genreId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create Book - Patron (expect 403)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/books"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Patron Attempt\",\n  \"author\": \"Test Author\",\n  \"isbn\": \"9780000000001\",\n  \"totalCopies\": 1,\n  \"genreId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patronToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update Book - Librarian",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Book Title\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Book - Librarian",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/genres"
            }
          }
        },
        {
          "name": "Get Genre by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}"
            }
          }
        },
        {
          "name": "Create Genre - Librarian",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/genres"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Genre\",\n  \"description\": \"Created during API testing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update Genre - Librarian",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated genre description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Genre - Librarian",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}